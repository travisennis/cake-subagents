#!/bin/sh
# Link the single subagent toolbox executable into Cake's global toolbox
# directory and install its report hooks. Build first: `just build` writes
# dist/cake-subagent.
#
#   bin/install                  # link tb__subagent; add SessionStart and Stop hooks
#   bin/install --pre-tool-use   # also drain reports before every tool call
#
# Re-run after changing the repository. Existing non-symlink files are never
# replaced, so a hand-written tool or hook script with the same name is safe.
# Legacy subagent_* links, the old subagent-inbox.sh link, and its hooks.json
# entry are removed only when they belong to this checkout.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd -P)
config=${XDG_CONFIG_HOME:-"$HOME/.config"}
dest=${CAKE_TOOLBOX_DEST:-"$config/cake/tools"}
binary=$root/dist/cake-subagent
hook_source=$root/hooks/subagent-reports.sh
hook_link=$config/cake/hooks/subagent-reports.sh
legacy="subagent_async subagent_cancel subagent_inbox subagent_peers subagent_send subagent_status subagent_wait"
legacy_hook=$config/cake/hooks/subagent-inbox.sh
pre_tool_use=

for arg in "$@"; do
    case "$arg" in
        --pre-tool-use) pre_tool_use=--pre-tool-use ;;
        -h | --help)
            sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            printf 'unknown option: %s\n' "$arg" >&2
            exit 2
            ;;
    esac
done

if [ ! -x "$binary" ]; then
    printf 'missing %s\n' "$binary" >&2
    printf 'run `just build` first\n' >&2
    exit 1
fi
if [ ! -f "$hook_source" ]; then
    printf 'missing %s\n' "$hook_source" >&2
    exit 1
fi

remove_owned_link() {
    link=$1
    [ -L "$link" ] || return 0
    target=$(readlink "$link")
    case "$target" in
        "$root"/*)
            rm -f "$link"
            printf 'removed legacy %s\n' "$link"
            ;;
    esac
}

mkdir -p "$dest"
for name in $legacy; do
    remove_owned_link "$dest/$name"
done
remove_owned_link "$legacy_hook"

link=$dest/subagent
if [ -e "$link" ] && [ ! -L "$link" ]; then
    printf 'refusing to replace non-symlink: %s\n' "$link" >&2
    exit 1
fi
ln -sfn "$binary" "$link"

mkdir -p "$(dirname "$hook_link")"
if [ -e "$hook_link" ] && [ ! -L "$hook_link" ]; then
    printf 'refusing to replace non-symlink: %s\n' "$hook_link" >&2
    exit 1
fi
ln -sfn "$hook_source" "$hook_link"

if ! "$binary" hooks install $pre_tool_use >/dev/null; then
    printf 'the tool is linked, but installing the report hooks failed\n' >&2
    printf 'fix %s/cake/hooks.json and re-run bin/install\n' "$config" >&2
    exit 1
fi

printf 'linked %s -> %s\n' "$link" "$binary"
printf 'linked %s -> %s\n' "$hook_link" "$hook_source"
if [ -n "$pre_tool_use" ]; then
    printf 'installed report hooks: SessionStart, Stop, PreToolUse (opt-in)\n'
else
    printf 'installed report hooks: SessionStart, Stop (PreToolUse stays opt-in)\n'
fi
printf 'The public tool is tb__subagent; remove old subagent_* entries from Cake settings if present.\n'
